# Copy to .env.local and fill in values from Supabase / Vercel dashboards.
# Supabase: https://supabase.com/dashboard/project/lwupkuhygzybnkoaoenr/settings/api
# Vercel: Project Settings → Environment Variables

# ── Required: Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://lwupkuhygzybnkoaoenr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Required: App URLs ────────────────────────────────────────────────────────
# Local dev: both localhost. Production split:
#   Marketing  → https://eateryvn.com
#   App        → https://app.eateryvn.com
# Local dev example:
#   NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production:
NEXT_PUBLIC_MARKETING_URL=https://eateryvn.com
NEXT_PUBLIC_APP_URL=https://app.eateryvn.com
NEXT_PUBLIC_SITE_URL=https://eateryvn.com

# ── Optional: Marketing blog (Google Sheets CMS export) ─────────────────────
# Uses the Eatery blog sheet by default. Override with your own sheet ID if needed.
# Image URLs (e.g. Bunny CDN) must be absolute https:// — they work on localhost too.
BLOG_GOOGLE_SHEET_ID=1tZQ1YEW-NnShU7yTZqNYRhO13EpBxwyOqAVqLvgNdUg

# ── Optional: Contact form destination ───────────────────────────────────────
CONTACT_EMAIL=hello@eateryvn.com

# ── Optional: Email (Resend) ─────────────────────────────────────────────────
# Without this, team invites log to the console instead of sending email.
RESEND_API_KEY=
NEXT_PUBLIC_SENDER_EMAIL=noreply@eateryvn.com

# ── Optional: PayOS payments ──────────────────────────────────────────────────
# Without these, PayOS uses dummy credentials (payments won't work).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ── Optional: Live Orders browser push (Web Push / VAPID) ─────────────────────
# Generate once: npx web-push generate-vapid-keys
# Save public + private in Vercel env vars, then redeploy. Never commit private key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@eateryvn.com

# ── Optional: Retention cron (hard-delete old orders) ─────────────────────────
# Used by POST /api/cron/purge-orders. Set a long random string in Vercel.
CRON_SECRET=

# ── Required for custom domains (platform setup — enables self-service for users) ─
# Create token: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Only if the Vercel project belongs to a team:
VERCEL_TEAM_ID=
